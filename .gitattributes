# Normalize text files
* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.ps1 text eol=crlf

# Formal binary documents retained through Git LFS
# Cover both current (docs/) and target (docx/) report directories
docs/**/*.docx filter=lfs diff=lfs merge=lfs -text
docs/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
docx/**/*.docx filter=lfs diff=lfs merge=lfs -text
docx/**/*.pdf  filter=lfs diff=lfs merge=lfs -text

# Large raw experiment artifacts retained through Git LFS
results/**/raw/**          filter=lfs diff=lfs merge=lfs -text
results/**/*.csv.gz        filter=lfs diff=lfs merge=lfs -text
results/**/*.parquet       filter=lfs diff=lfs merge=lfs -text
results/**/*.npy           filter=lfs diff=lfs merge=lfs -text
results/**/*.npz           filter=lfs diff=lfs merge=lfs -text
results/**/*.pkl           filter=lfs diff=lfs merge=lfs -text
results/**/*.joblib        filter=lfs diff=lfs merge=lfs -text
